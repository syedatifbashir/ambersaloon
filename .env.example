# ==============================================================================
# Amber's Salon — Production Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RESEND EMAIL API (Recommended for 100% reliable transactional emails)
# Get your free key at: https://resend.com/api-keys
# Free tier allows 3,000 emails/month (100 emails/day), zero SMTP server configuration.
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender email in Resend (defaults to onboarding@resend.dev during testing)
# After adding your custom domain in Resend, use e.g. Amber's Salon <bookings@ambersaloon.vercel.app>
RESEND_FROM_EMAIL="Amber's Salon <onboarding@resend.dev>"

# Salon internal notification email (where booking copies are delivered)
SALON_EMAIL=ambersaloonlahore@gmail.com


# ------------------------------------------------------------------------------
# 2. META WHATSAPP BUSINESS CLOUD API (Official WhatsApp automated notifications)
# Setup at: https://developers.facebook.com/apps/
# ------------------------------------------------------------------------------
# System User or Permanent Access Token from Meta Developer Console
WHATSAPP_TOKEN=EAAG...xxxxxxxx

# Phone Number ID from WhatsApp API Setup dashboard (15-digit number)
WHATSAPP_PHONE_NUMBER_ID=109283746501928

# (Optional) Pre-approved Meta Message Template Name (e.g. appointment_confirmation)
# If omitted, a clean text notification will be sent.
WHATSAPP_TEMPLATE_NAME=


# ------------------------------------------------------------------------------
# 3. SALON INFORMATION & NOTIFICATION PHONE
# ------------------------------------------------------------------------------
SALON_PHONE_NOTIFICATION=923014398287
